# Bedrud remote debug — NEVER commit
#
# Architecture (beddev.a16.at):
#   Debug server (edge):  devtunnel agent + Traefik + LiveKit
#   Your machine (local): Vite :7070 + API :7071 (hot reload via air)
#
#   Traefik on the server:
#     /           → tunnel → local :7070 (frontend)
#     /api        → tunnel → local :7071 (backend)
#     /livekit    → remote LiveKit :7072 (stays on server, NOT tunneled)
#
#   Tunnel (pick one in server/remote-debug.yaml):
#     devtunnel   outbound TCP mux (recommended)
#     ssh         rootless SSH -R/-L port forwards
#     wireguard   sudo wg-quick up → local 10.0.0.2, remote 10.0.0.1
#
# Server:  104.105.28.31
# Domain:  beddev.a16.at → A 104.105.28.31 (DNS-only, no CF proxy)

# --- SSH (provision, traefik sync, remote ssh) ---
REMOTE_DEBUG_SSH_HOST=104.105.28.31
REMOTE_DEBUG_SSH_USER=root
REMOTE_DEBUG_SSH_PORT=22
REMOTE_DEBUG_SSH_IDENTITY_FILE=~/.ssh/id_rsa

# --- Public domain (also used as WireGuard endpoint host) ---
REMOTE_DEBUG_PUBLIC_HOST=beddev.a16.at
REMOTE_DEBUG_WG_ENDPOINT=beddev.a16.at:51820

# devtunnel agent (filled by: make dev-remote-provision / devcli remote tunnel deploy)
REMOTE_DEBUG_TUNNEL_TOKEN=9c77d43170a16001e1064dd9ad2bedfb7f91aa376bb969dd
REMOTE_DEBUG_TUNNEL_TLS_FINGERPRINT=bb98295c59e578db522d689eea20f0ba8d7a71d05817835f224821e8b3e30fb1

# --- LiveKit (runs on server; local API reaches it via tunnel) ---
# Leave empty on first provision to auto-generate, or set a stable secret.
REMOTE_DEBUG_LIVEKIT_API_SECRET=410548a60f5e16f800117d7532bebce85b43541e0ee911d2624698a2cb6bfb34

# --- Optional: Let's Encrypt for Traefik TLS (set provision.enableACME: true) ---
REMOTE_DEBUG_ACME_EMAIL=ops@a16.at
